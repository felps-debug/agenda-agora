SUPABASE_PROJECT_ID=your-value-here
SUPABASE_PUBLISHABLE_KEY=your-value-here
SUPABASE_URL=your-value-here
VITE_SUPABASE_PROJECT_ID=your-value-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-value-here
VITE_SUPABASE_URL=your-value-here
VITE_SPLIT_PANELS=false

# Template versionado: segredos devem ficar apenas no .env.local ou no ambiente de deploy.
SUPABASE_SERVICE_ROLE_KEY=your-value-here
SUPABASE_ACCESS_TOKEN=your-value-here
SUPABASE_DB_PASSWORD=your-value-here
UAZAPI_BASE_URL=your-value-here
UAZAPI_TOKEN=your-value-here
UAZAPI_ADMIN_TOKEN=your-value-here

AGENDA_CRON_SECRET=your-value-here
AGENDA_CRON_SECRET_PREVIOUS=your-value-here
MASTER_RETURN_PIN=41410070
MASTER_SECURITY_PIN=41410070
SDR_TOKEN_SECRET=your-value-here
ALLOWED_APP_ORIGINS=https://painel.agendagora.company,https://admin.agendagora.company

# Credenciais do gateway de pagamento AgPay.
AGPAY_API_TOKEN=your-value-here
# Retransmissor gratuito com IP fixo (opcional; usado só se o AgPay exigir IP na lista).
AGPAY_EGRESS_PROXY_URL=your-value-here
AGPAY_EGRESS_PROXY_SECRET=your-value-here

# Saudação automática do WhatsApp (aba "Saudação" em /painel/lembretes).
# URL pública do app (recebe os webhooks de mensagens) + segredo do webhook.
PUBLIC_APP_URL=your-value-here
WHATSAPP_WEBHOOK_SECRET=your-value-here
# Base do link de agendamento usado pelo campo {Link} (padrão: app.agendagora.company).
PUBLIC_BOOKING_BASE_URL=your-value-here

# Negócio dedicado a testes de integração do ledger (lançamentos são imutáveis; nunca use um negócio real)
LEDGER_TEST_BUSINESS_ID=

# Local QA: ALLOWED_APP_ORIGINS=http://localhost:3002 (set in .env.local)
